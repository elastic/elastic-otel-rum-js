# MySQL
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_DATABASE=elaspic
MYSQL_USER=elaspic
MYSQL_PASSWORD=changeme-app

# API (optional overrides)
SESSION_TTL_SECONDS=86400
BCRYPT_ROUNDS=12
MAX_UPLOAD_BYTES=5242880
THUMBNAIL_MAX_EDGE_PX=320
THUMBNAIL_JPEG_QUALITY=80

# Edge proxy
NGINX_HTTP_PORT=8080
API_UPSTREAM=api:3000
UI_UPSTREAM=ui:80
PUBLIC_API_PREFIX=/api

# OpenTelemetry forward proxy (nginx /collect/)
# Use a real collector URL in production; placeholder is fine for local UI/API-only dev
OTEL_EXPORTER_OTLP_ENDPOINT=https://example.com/
ELASTIC_OTEL_API_KEY=
