{
  "manifest_version": 3,
  "name": "Elastic OpenTelemetry Browser Extension",
  "version": "0.1.0",
  "description": "Inject EDOT Browser on configured websites and export telemetry to Elastic",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "EDOT Browser Monitor"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
